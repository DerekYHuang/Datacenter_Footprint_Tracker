# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored -- never commit real keys.

# Free key from https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# Envirofacts does not require a key, but we keep a base URL here
# in case EPA changes endpoints or you add a key-gated data source later.
ENVIROFACTS_BASE_URL=https://data.epa.gov/efservice

# Optional: only needed if you add a Census API pull later
# Free key from https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Local warehouse file (DuckDB). Safe to keep as-is.
DUCKDB_PATH=data/processed/warehouse.duckdb

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
